#!/usr/bin/env bash
# Entry point for every mode.
#
#   check   -- fail a PR that changes a package without adding a changeset
#   upload  -- on the default branch, work out whether this build opens the
#              version PR or releases, and upload the step for it
#   version -- open or update the "Version Packages" PR
#   release -- publish or stage, then create the GitHub release
#
# version and release are normally generated by `upload` rather than written by
# hand, but they are accepted directly so a pipeline can drive either half
# itself.
#
# The check/upload split exists because Buildkite has no equivalent of GitHub's
# `on: push: branches: [main]`, so the filtering has to happen somewhere.
#
# This is a post-command hook, not a command hook, and deliberately so: a
# command hook *overrides* the step's own command, which would silently discard
# the `command:` a consumer uses to install their toolchain and dependencies.
# Every mode here needs the changesets CLI on PATH, so the consumer's command
# has to run first; post-command runs after it in the same job, with whatever it
# installed.
#
# What the command installs, not what it activates: files it writes are here,
# but PATH or other variables it exports are not, because the command runs in
# its own shell. A toolchain the command puts on PATH has to be put there by a
# hook instead (an environment or post-checkout hook), or this hook runs on the
# agent's default node. lib/require-cli.sh fails the job when that node cannot
# load the CLI.
#
# post-command runs even when the command failed, and its own exit code can
# replace the command's as the job result -- so a failed install must not be
# reported as a changeset failure. Bail out early instead, leaving the real
# error as the job's result.
set -euo pipefail

if [[ "${BUILDKITE_COMMAND_EXIT_STATUS:-0}" != "0" ]]; then
  echo "Step command exited ${BUILDKITE_COMMAND_EXIT_STATUS}; skipping changesets."
  exit "${BUILDKITE_COMMAND_EXIT_STATUS}"
fi

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PLUGIN_DIR

MODE="${BUILDKITE_PLUGIN_CHANGESETS_MODE:?mode is required (check or upload)}"

case "$MODE" in
  check)
    exec "$PLUGIN_DIR/lib/mode-check.sh"
    ;;
  upload)
    exec "$PLUGIN_DIR/lib/mode-upload.sh"
    ;;
  version)
    exec "$PLUGIN_DIR/lib/version.sh"
    ;;
  release)
    exec "$PLUGIN_DIR/lib/publish.sh"
    ;;
  *)
    echo "Unknown mode '$MODE'. Expected 'check' or 'upload'." >&2
    exit 1
    ;;
esac
