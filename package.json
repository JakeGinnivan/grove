{
  "name": "@jakeginnivan/grove",
  "version": "0.1.0",
  "description": "Git worktree manager with profiles, shell integration, and agent-friendly non-interactive commands",
  "keywords": [
    "git",
    "worktree",
    "cli",
    "developer-tools"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/JakeGinnivan/worktree-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakeGinnivan/worktree-cli.git"
  },
  "bugs": {
    "url": "https://github.com/JakeGinnivan/worktree-cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "grove": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@types/node": "^26.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
